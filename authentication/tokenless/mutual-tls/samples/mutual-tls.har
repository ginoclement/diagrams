        "cache": {},
        "timings": { "send": 1, "wait": 46, "receive": 1 },
        "_securityDetails": {
          "protocol": "TLS 1.3",
          "clientCertRequested": true,
          "clientCertSubject": "CN=svc-orders,O=Example,OU=payments",
          "clientCertIssuer": "CN=Synthetic Test CA",
          "clientCertSAN": "URI:spiffe://example.com/ns/pay/sa/orders",
          "clientCertNotBefore": "2026-07-25T00:00:00Z",
          "clientCertNotAfter": "2026-10-23T00:00:00Z",
          "clientCertVerify": "SUCCESS",
          "comment": "Non-standard HAR extension field (underscore-prefixed). Populated from openssl s_client for documentation; browsers do not expose this in the Network tab."
