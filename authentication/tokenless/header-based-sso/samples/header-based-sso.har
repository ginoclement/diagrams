      {
        "startedDateTime": "2026-07-25T10:00:20.010Z",
        "time": 8,
        "comment": "Proxy->app upstream hop. Proxy STRIPPED any inbound copy and INJECTED verified identity headers.",
        "request": {
          "method": "GET",
          "url": "http://orders-app.internal.svc/reports",
          "httpVersion": "HTTP/1.1",
          "cookies": [],
          "headers": [
            { "name": "host", "value": "orders-app.internal.svc" },
            { "name": "x-forwarded-user", "value": "alice" },
            { "name": "x-auth-request-email", "value": "alice@example.com" },
            { "name": "x-forwarded-groups", "value": "reports-viewers,staff" },
            { "name": "x-forwarded-for", "value": "203.0.113.7" }
          ],
          "queryString": [],
          "headersSize": -1,
          "bodySize": 0
        },
        "response": {
          "status": 200,
          "statusText": "OK",
          "httpVersion": "HTTP/1.1",
          "cookies": [],
          "headers": [
            { "name": "content-type", "value": "application/json" }
          ],
          "content": { "size": 34, "mimeType": "application/json", "text": "{\"user\":\"alice\",\"via\":\"proxy\"}" },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 34
