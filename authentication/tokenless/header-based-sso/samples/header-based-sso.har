        "time": 30,
        "comment": "Browser->proxy AFTER login. Carries the proxy session cookie only, NO identity header.",
        "request": {
          "method": "GET",
          "url": "https://app.example.com/reports",
          "httpVersion": "HTTP/2",
          "cookies": [
