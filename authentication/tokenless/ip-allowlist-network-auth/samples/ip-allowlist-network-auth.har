{
  "log": {
    "version": "1.2",
    "creator": { "name": "diagrams-handson-synthetic", "version": "1.0" },
    "comment": "SYNTHETIC IP-allowlist capture. Note the ABSENCE of any credential. Addresses use RFC 5737 documentation ranges. No real IPs or PII.",
    "entries": [
      {
        "startedDateTime": "2026-07-25T10:00:00.000Z",
        "time": 22,
        "comment": "On-network request from an allowlisted source IP (203.0.113.7). No credential present.",
        "request": {
          "method": "GET",
          "url": "https://admin.example.com/panel",
          "httpVersion": "HTTP/2",
          "cookies": [],
          "headers": [
            { "name": "host", "value": "admin.example.com" },
            { "name": "accept", "value": "text/html" }
          ],
          "queryString": [],
          "headersSize": -1,
          "bodySize": 0
        },
        "response": {
          "status": 200,
          "statusText": "OK",
          "httpVersion": "HTTP/2",
          "cookies": [],
          "headers": [
            { "name": "content-type", "value": "text/html; charset=utf-8" }
          ],
          "content": { "size": 32, "mimeType": "text/html", "text": "<h1>Admin Panel</h1>" },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 32
        },
        "cache": {},
        "timings": { "send": 1, "wait": 20, "receive": 1 },
        "_networkContext": {
          "clientSourceIp": "203.0.113.7",
          "allowlist": ["203.0.113.0/24"],
          "decision": "ALLOW",
          "comment": "Non-standard HAR extension. The source IP is evaluated at the gateway, not carried in the HTTP request."
        }
      },
      {
        "startedDateTime": "2026-07-25T10:05:00.000Z",
        "time": 18,
        "comment": "Same request, off-network source IP (198.51.100.23). Rejected at the gateway.",
        "request": {
          "method": "GET",
          "url": "https://admin.example.com/panel",
          "httpVersion": "HTTP/2",
          "cookies": [],
          "headers": [
            { "name": "host", "value": "admin.example.com" },
            { "name": "accept", "value": "text/html" }
          ],
          "queryString": [],
          "headersSize": -1,
          "bodySize": 0
        },
        "response": {
          "status": 403,
          "statusText": "Forbidden",
          "httpVersion": "HTTP/2",
          "cookies": [],
          "headers": [
            { "name": "content-type", "value": "application/json" }
          ],
          "content": { "size": 38, "mimeType": "application/json", "text": "{\"error\":\"not on an allowed network\"}" },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 38
        },
        "cache": {},
        "timings": { "send": 1, "wait": 16, "receive": 1 },
        "_networkContext": {
          "clientSourceIp": "198.51.100.23",
          "allowlist": ["203.0.113.0/24"],
          "decision": "DENY",
          "comment": "Ideally the service is not even discoverable off-net (connection reset) rather than a polite 403."
        }
      },
      {
        "startedDateTime": "2026-07-25T10:06:00.000Z",
        "time": 17,
        "comment": "Off-network request forging X-Forwarded-For to fake an allowed IP. Gateway ignores it (decides on transport peer).",
        "request": {
          "method": "GET",
          "url": "https://admin.example.com/panel",
          "httpVersion": "HTTP/2",
          "cookies": [],
          "headers": [
            { "name": "host", "value": "admin.example.com" },
            { "name": "x-forwarded-for", "value": "203.0.113.5" }
          ],
          "queryString": [],
          "headersSize": -1,
          "bodySize": 0
        },
        "response": {
          "status": 403,
          "statusText": "Forbidden",
          "httpVersion": "HTTP/2",
          "cookies": [],
          "headers": [
            { "name": "content-type", "value": "application/json" }
          ],
          "content": { "size": 38, "mimeType": "application/json", "text": "{\"error\":\"not on an allowed network\"}" },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 38
        },
        "cache": {},
        "timings": { "send": 1, "wait": 15, "receive": 1 },
        "_networkContext": {
          "clientSourceIp": "198.51.100.23",
          "spoofedHeader": "X-Forwarded-For: 203.0.113.5",
          "decision": "DENY",
          "comment": "X-Forwarded-For is client-controlled and untrusted; gateway used the real transport peer 198.51.100.23."
        }
      }
    ]
  }
}
